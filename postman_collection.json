{
  "info": {
    "name": "TB4 — Phone Auth & Referral",
    "description": "Коллекция запросов для API сервиса авторизации по номеру телефона с реферальной системой.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "phone", "value": "+79991234567", "type": "string" },
    { "key": "code", "value": "1234", "type": "string" },
    { "key": "access", "value": "", "type": "string" },
    { "key": "refresh", "value": "", "type": "string" },
    { "key": "invite_code", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Request SMS code",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/request-code/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "request-code", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.debug_code) { pm.collectionVariables.set('code', data.debug_code); }",
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Verify code",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"{{code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/verify-code/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "verify-code", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.access) pm.collectionVariables.set('access', data.access);",
              "if (data.refresh) pm.collectionVariables.set('refresh', data.refresh);",
              "if (data.user && data.user.invite_code) pm.collectionVariables.set('invite_code', data.user.invite_code);",
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Refresh access token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}" },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/refresh/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "refresh", ""]
        }
      }
    },
    {
      "name": "4. Me (short profile)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access}}" }],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/me/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "me", ""]
        }
      }
    },
    {
      "name": "5. Full profile (with referrals)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access}}" }],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/profile/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "profile", ""]
        }
      }
    },
    {
      "name": "6. Activate invite code",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invite_code\": \"{{invite_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/profile/activate-invite/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "profile", "activate-invite", ""]
        }
      }
    }
  ]
}
